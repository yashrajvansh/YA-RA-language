{
  "name": "YA|RA",
  "scopeName": "source.ya-ra",
  "fileTypes": ["YA-RA", "ya-ra"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#intent" },
    { "include": "#pattern" },
    { "include": "#signed" },
    { "include": "#keyword" },
    { "include": "#check" },
    { "include": "#use" },
    { "include": "#version" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.ya-ra",
      "match": "#.*$"
    },
    "intent": {
      "name": "meta.intent.ya-ra",
      "match": "^(Intent)\\s*:\\s*(.*)$",
      "captures": {
        "1": { "name": "keyword.control.intent.ya-ra" },
        "2": { "name": "string.unquoted.intent.ya-ra" }
      }
    },
    "pattern": {
      "name": "meta.pattern.ya-ra",
      "match": "^(Pattern)\\s*:\\s*(.*)$",
      "captures": {
        "1": { "name": "keyword.control.pattern.ya-ra" },
        "2": { "name": "string.unquoted.pattern.ya-ra" }
      }
    },
    "signed": {
      "name": "meta.envelope.ya-ra",
      "match": "^(Signed)\\.\\s*(.+)\\s*/\\s*(.+)$",
      "captures": {
        "1": { "name": "keyword.operator.envelope.ya-ra" },
        "2": { "name": "entity.name.actor.ya-ra" },
        "3": { "name": "constant.other.timestamp.ya-ra" }
      }
    },
    "keyword": {
      "name": "keyword.other.ya-ra",
      "match": "^(00|0|glimpse|cut|universe|cura|measure\\s+(all|any))$"
    },
    "check": {
      "name": "meta.check.ya-ra",
      "match": "^(⊦|check)\\s+(words|exists|run|contains|eq|use)\\s+(.*)$",
      "captures": {
        "1": { "name": "punctuation.definition.check.ya-ra" },
        "2": { "name": "entity.name.function.check.ya-ra" },
        "3": {
          "name": "string.unquoted.args.ya-ra",
          "patterns": [
            { "include": "#binding-ref" },
            { "include": "#binding-as" },
            { "include": "#binding-amp" }
          ]
        }
      }
    },
    "binding-ref": {
      "comment": "$NAME: a prior check's bound value, substituted into this argument. rv0.3.",
      "name": "variable.other.reference.ya-ra",
      "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
    },
    "binding-as": {
      "comment": "trailing `as NAME`: names this check's own value for later checks to reference via $NAME. rv0.3.",
      "match": "\\b(as)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.operator.bind.ya-ra" },
        "2": { "name": "variable.other.definition.ya-ra" }
      }
    },
    "binding-amp": {
      "comment": "trailing `amp N`: a complex amplitude. Composes with `as` in either order.",
      "match": "\\b(amp)\\s+(\\S+)",
      "captures": {
        "1": { "name": "keyword.operator.amp.ya-ra" },
        "2": { "name": "constant.numeric.amp.ya-ra" }
      }
    },
    "use": {
      "name": "meta.use.ya-ra",
      "match": "^(use)\\s+(\\S+)$",
      "captures": {
        "1": { "name": "keyword.control.use.ya-ra" },
        "2": { "name": "string.unquoted.path.ya-ra" }
      }
    },
    "version": {
      "name": "constant.numeric.rv.ya-ra",
      "match": "^rv\\s*\\d+(?:\\.\\d+){0,2}$"
    }
  }
}
